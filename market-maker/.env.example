# ApeX Market Maker Configuration

SOLANA_RPC_URL=https://api.devnet.solana.com
APEX_PROTOCOL_PROGRAM_ID=E7hafM67eM1VWxo1LvKeYAzK3jk4TZKUbKMQqAadnd2s

# Collateral mint for the market being quoted (devnet USDC by default).
APEX_BASE_MINT=4zMMC9srt5Ri5X14GVnYj7wAVTJGN1YjBe5HL4s3bQDa

# Quoting keypair. Needs SOL for fees and margin deposited via deposit_margin
# before it can post orders. JSON byte array or base58 secret key.
MM_PRIVATE_KEY=

# Half-spread of the innermost quote, in basis points (10 = 0.10%).
MM_SPREAD_BPS=10
# Extra basis points between each successive level.
MM_LEVEL_STEP_BPS=5
# Levels per side.
MM_LEVELS=5
# Quote-denominated notional per order, in whole collateral tokens.
MM_ORDER_NOTIONAL=100
# Leverage used for each quote (1-10). Locked collateral is ceil(size/leverage).
MM_LEVERAGE=2
# How often to cancel and re-anchor quotes to the oracle.
MM_REQUOTE_INTERVAL_MS=20000
