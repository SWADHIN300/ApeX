# Jupiter swap provider
# Create the key in the Jupiter developer portal and keep it server-side only.
JUPITER_API_KEY=
JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v1

# Optional: only set this if you have a devnet swap provider.
# Jupiter public swap liquidity is mainly mainnet, so devnet needs a separate provider.
JUPITER_DEVNET_SWAP_API_URL=

# Real deposit/ledger configuration
NEXT_PUBLIC_APEX_TREASURY_WALLET=
NEXT_PUBLIC_APEX_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_APEX_DEVNET_USDC_MINT=
LEDGER_SYNC_SECRET=
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_MAINNET_RPC_URL=

# Neon / app auth
DATABASE_URL=
AUTH_SECRET=

# Solana protocol order placement
NEXT_PUBLIC_APEX_PROTOCOL_PROGRAM_ID=E7hafM67eM1VWxo1LvKeYAzK3jk4TZKUbKMQqAadnd2s
# Either set one fallback mint for every market, or map symbols to base mints:
NEXT_PUBLIC_APEX_BASE_MINT=
NEXT_PUBLIC_APEX_MARKET_MINTS=
