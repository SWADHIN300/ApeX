# ApeX Indexer Configuration

# Solana RPC endpoint to read transactions and stream logs from.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployed program id.
APEX_PROTOCOL_PROGRAM_ID=D643vETCKW14hgvpmUoWZTYi65R9tijNm1RGmZFfS6g1

# Maps each market's base (collateral) mint to the pair label the frontend uses.
# The OrderFilled event carries no symbol, so this is how fills are attributed.
MARKET_PAIRS={"4zMMC9srt5Ri5X14GVnYj7wAVTJGN1YjBe5HL4s3bQDa":"BTC-PERP"}

# How many historical signatures to replay per market on startup.
BACKFILL_LIMIT=1000

# Postgres connection (same database the Next.js app reads from).
DATABASE_URL=

# Leave unset in production. Only set to "true" for self-hosted Postgres
# presenting a certificate from a private CA.
# DATABASE_SSL_NO_VERIFY=false
